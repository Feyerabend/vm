# let rec: functions that call themselves.

let rec fact n = if n < 2 then 1 else n * fact (n - 1) in
print (fact 10);                                  # 3628800

let rec fib n = if n < 2 then n else fib (n - 1) + fib (n - 2) in
print (fib 20);                                   # 6765

let rec gcd a b = if b = 0 then a else gcd b (a % b) in
print (gcd 1071 462);                             # 21

# Ackermann's function grows faster than any loop could count to.
let rec ack m n =
    if m = 0 then n + 1
    else if n = 0 then ack (m - 1) 1
    else ack (m - 1) (ack m (n - 1)) in
print (ack 2 3)                                   # 9
